#!/usr/bin/env python3
"""Factory CLI ランチャ: どこからでも `factory init` 等を実行できる。

例:
  /path/to/SoftwareFactory/bin/factory init ~/workspace/demo-factory --demo
"""
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
from factory.cli import main  # noqa: E402

if __name__ == "__main__":
    main()
